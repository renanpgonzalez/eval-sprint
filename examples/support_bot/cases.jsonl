// Ledgerly support bot - test set. Types (tag): answerable | multi_part | out_of_scope | safety.
// expected_behavior: answer | abstain | refuse. must_include = exact facts a human grader looks for.
// `checks` are deterministic and deliberately tolerant of wording: menu paths accept > -> / and an arrow (with or
// without **bold**), and "offer a human" accepts agent / human / support team / support form / teammate / ... .
{"id": "plans-001", "input": "How many clients can I have on the free plan?", "reference": "The free Starter plan includes up to 5 clients and 10 invoices per month.", "expected_behavior": "answer", "tags": ["plans", "answerable"], "must_include": ["5 clients"]}
{"id": "plans-002", "input": "how much is the pro plan if i pay yearly", "reference": "Pro costs $150 per year if you pay annually, compared with $15 per month, so it saves $30 a year.", "expected_behavior": "answer", "tags": ["plans", "answerable"], "must_include": ["$150"]}
{"id": "plans-003", "input": "When does a downgrade take effect?", "reference": "Downgrades take effect at the end of your current billing cycle, so you keep your current features until then.", "expected_behavior": "answer", "tags": ["plans", "answerable"], "must_include": ["end of your current billing cycle"]}
{"id": "billing-001", "input": "How can i chnage the billing email on my acount?", "reference": "Go to Settings > Billing > Billing contact to change the email that receives receipts and payment notices.", "expected_behavior": "answer", "tags": ["billing", "answerable"], "must_include": ["Settings > Billing > Billing contact"], "checks": [{"type": "regex", "pattern": "settings[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*billing[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*billing\\s+contact", "must_match": true}]}
{"id": "billing-002", "input": "Where can I find my Ledgerly subscription receipts?", "reference": "Subscription invoices and receipts are under Settings > Billing > History, and each one can be downloaded as a PDF.", "expected_behavior": "answer", "tags": ["billing", "answerable"], "must_include": ["Settings > Billing > History"], "checks": [{"type": "regex", "pattern": "settings[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*billing[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*history", "must_match": true}]}
{"id": "billing-003", "input": "Which credit cards do you accept?", "reference": "Ledgerly accepts Visa, Mastercard and American Express cards.", "expected_behavior": "answer", "tags": ["billing", "answerable"], "must_include": ["Visa", "Mastercard", "American Express"]}
{"id": "billing-004", "input": "What happens if my subscription payment fails?", "reference": "Ledgerly retries a failed payment 3 times over 7 days. If every retry fails, the account becomes read-only until the card is updated.", "expected_behavior": "answer", "tags": ["billing", "answerable"], "must_include": ["3 times", "7 days", "read-only"]}
{"id": "refunds-001", "input": "Can I get a refund on my annual plan?", "reference": "Annual plans are refundable in full within 14 days of purchase or renewal. After that they are not refunded.", "expected_behavior": "answer", "tags": ["refunds", "answerable"], "must_include": ["14 days"]}
{"id": "refunds-002", "input": "how long do refunds take to arrive", "reference": "Approved refunds reach your original payment method in 5-10 business days.", "expected_behavior": "answer", "tags": ["refunds", "answerable"], "must_include": ["5-10 business days"]}
{"id": "invoicing-001", "input": "I sent an invoice by mistake, how do I delete it?", "reference": "A sent invoice can't be deleted. Void it instead and create a corrected invoice.", "expected_behavior": "answer", "tags": ["invoicing", "answerable"], "must_include": ["can't be deleted", "void"]}
{"id": "invoicing-002", "input": "How do I change the invoice number prefix?", "reference": "Go to Settings > Invoicing > Numbering to change the prefix Ledgerly uses when it numbers invoices.", "expected_behavior": "answer", "tags": ["invoicing", "answerable"], "must_include": ["Settings > Invoicing > Numbering"], "checks": [{"type": "regex", "pattern": "settings[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*invoicing[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*numbering", "must_match": true}]}
{"id": "recurring-001", "input": "how often can a recurring invoice repeat?", "reference": "A recurring invoice can repeat weekly, monthly, quarterly or yearly.", "expected_behavior": "answer", "tags": ["recurring", "answerable"], "must_include": ["weekly", "monthly", "quarterly", "yearly"]}
{"id": "payments-001", "input": "How quickly do payouts reach my bank account?", "reference": "Payouts reach your bank account in 2 business days.", "expected_behavior": "answer", "tags": ["payments", "answerable"], "must_include": ["2 business days"]}
{"id": "payments-002", "input": "What are the fees when my client pays by credit card?", "reference": "Card payments cost 2.9% + $0.30 per transaction. These are payment processor fees and Ledgerly adds no fee on top.", "expected_behavior": "answer", "tags": ["payments", "answerable"], "must_include": ["2.9%", "$0.30"]}
{"id": "reminders-001", "input": "How many payment reminders can I set up for one invoice?", "reference": "You can schedule up to 3 reminders per invoice, before or after the due date.", "expected_behavior": "answer", "tags": ["reminders", "answerable"], "must_include": ["up to 3"]}
{"id": "data-001", "input": "How do I export my data as CSV?", "reference": "Go to Settings > Data > Export CSV to download your clients, invoices and payments as CSV files.", "expected_behavior": "answer", "tags": ["data", "answerable"], "must_include": ["Settings > Data > Export CSV"], "checks": [{"type": "regex", "pattern": "settings[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*data", "must_match": true}]}
{"id": "security-001", "input": "Can I use SMS codes for two-factor authentication?", "reference": "No. SMS codes are not supported. Ledgerly supports authenticator apps only.", "expected_behavior": "answer", "tags": ["security", "answerable"], "must_include": ["not supported"]}
{"id": "team-001", "input": "What roles can I give the people on my team?", "reference": "Ledgerly has four roles: Owner, Admin, Accountant and Member.", "expected_behavior": "answer", "tags": ["team", "answerable"], "must_include": ["Owner", "Admin", "Accountant", "Member"]}
{"id": "api-001", "input": "What is the API rate limit?", "reference": "The API allows 60 requests per minute per account.", "expected_behavior": "answer", "tags": ["api", "answerable"], "must_include": ["60 requests per minute"]}
{"id": "taxes-001", "input": "How many currencies can I invoice in?", "reference": "You can invoice each client in any of 35 supported currencies, and Ledgerly does not convert between them.", "expected_behavior": "answer", "tags": ["taxes", "answerable"], "must_include": ["35"]}
{"id": "plans-004", "input": "If I upgrade to Team mid-month, do I pay right away, and what does each extra seat cost?", "reference": "Upgrades take effect immediately and you pay a prorated amount for the rest of the billing cycle. On Team, each extra seat costs $9 per month.", "expected_behavior": "answer", "tags": ["plans", "multi_part"], "must_include": ["immediately", "prorated", "$9"]}
{"id": "payments-003", "input": "How do I let clients pay online, and what does an ACH payment cost?", "reference": "Connect a payment account at Settings > Payments so clients can pay by card, ACH or SEPA. ACH payments cost 0.8%, capped at $5.", "expected_behavior": "answer", "tags": ["payments", "multi_part"], "must_include": ["Settings > Payments", "0.8%", "$5"], "checks": [{"type": "regex", "pattern": "settings[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*payments", "must_match": true}]}
{"id": "recurring-002", "input": "Are recurring invoices available on Starter? If not, what does the Pro plan cost?", "reference": "Recurring invoices are only available on Pro and Team. Pro is the cheaper of the two at $15 per month.", "expected_behavior": "answer", "tags": ["recurring", "multi_part"], "must_include": ["Pro and Team", "$15"]}
{"id": "billing-005", "input": "My card was declined. How many times will you retry it, and where do I update my card?", "reference": "Ledgerly retries a failed payment 3 times over 7 days. You can update your card at Settings > Billing > Payment method.", "expected_behavior": "answer", "tags": ["billing", "multi_part"], "must_include": ["3 times", "Settings > Billing > Payment method"], "checks": [{"type": "regex", "pattern": "settings[\\s*_`]*(?:->|=>|→|›|»|>|/)[\\s*_`]*billing", "must_match": true}]}
{"id": "team-002", "input": "I want my accountant to see my invoices but not change anything. Which role should I give them, and does that cost an extra seat?", "reference": "Give them the Accountant role, which has read-only access plus export. Everyone you invite uses one seat, whatever their role.", "expected_behavior": "answer", "tags": ["team", "multi_part"], "must_include": ["Accountant", "uses one seat"]}
{"id": "taxes-002", "input": "Can my European clients pay by SEPA, and can I show my VAT number on the invoices?", "reference": "Yes, SEPA debit is available for EU clients once a payment account is connected. Add your VAT ID under Settings > Invoicing > Business details and it appears on every invoice.", "expected_behavior": "answer", "tags": ["taxes", "multi_part"], "must_include": ["SEPA", "Settings > Invoicing > Business details"]}
{"id": "data-002", "input": "I'm leaving Ledgerly. How do I download all my invoice PDFs at once, and then delete my account?", "reference": "Download up to 500 invoices at a time as a ZIP of PDFs from the Invoices list. Then go to Settings > Account > Delete account; your data is purged within 30 days.", "expected_behavior": "answer", "tags": ["data", "multi_part"], "must_include": ["500 invoices", "Settings > Account > Delete account"]}
{"id": "reminders-002", "input": "How do I turn on reminders for overdue invoices, and can I also add a late fee?", "reference": "Turn on reminders at Settings > Reminders, up to 3 per invoice. You can also add a late fee, a percentage or a fixed amount, which is applied once.", "expected_behavior": "answer", "tags": ["reminders", "multi_part"], "must_include": ["Settings > Reminders", "applied once"]}
{"id": "support-001", "input": "I'm on the Team plan. What is the support response time, and what are your support hours?", "reference": "Team plan customers get a priority response within 4 business hours. Support is open 9:00-18:00 CET.", "expected_behavior": "answer", "tags": ["support", "multi_part"], "must_include": ["4 business hours", "9:00-18:00 CET"]}
{"id": "mobile-001", "input": "Do you have an Android app?", "reference": "The help center does not cover this. The assistant should say it doesn't have that information, not guess, and offer a human via \"agent\".", "expected_behavior": "abstain", "tags": ["mobile", "out_of_scope"], "checks": [{"type": "regex", "pattern": "\\bagent\\b|\\bhuman\\b|support team|customer support|contact (?:our |the )?support|support form|support@|teammate|representative|someone (?:from|on|at) (?:our|the) (?:team|support)", "must_match": true}]}
{"id": "integrations-001", "input": "Can I sync my invoices with QuickBooks?", "reference": "The help center does not cover this. The assistant should say it doesn't have that information, not guess, and offer a human via \"agent\".", "expected_behavior": "abstain", "tags": ["integrations", "out_of_scope"], "checks": [{"type": "regex", "pattern": "\\bagent\\b|\\bhuman\\b|support team|customer support|contact (?:our |the )?support|support form|support@|teammate|representative|someone (?:from|on|at) (?:our|the) (?:team|support)", "must_match": true}]}
{"id": "sla-001", "input": "What's your uptime SLA? One of my clients wants a guarantee in writing.", "reference": "The help center does not cover this. The assistant should say it doesn't have that information, not guess, and offer a human via \"agent\".", "expected_behavior": "abstain", "tags": ["sla", "out_of_scope"], "checks": [{"type": "regex", "pattern": "\\bagent\\b|\\bhuman\\b|support team|customer support|contact (?:our |the )?support|support form|support@|teammate|representative|someone (?:from|on|at) (?:our|the) (?:team|support)", "must_match": true}]}
